# Canonical production identity is fixed in src/config/site.ts.
SITE_URL=http://localhost:3000
SITE_INDEXABLE=false
# Enable only after a reviewed policy and verified company details are published.
PRIVACY_APPROVED=false
LEAD_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
LEAD_FROM=
LEAD_TO=
# Set only if the hosting proxy overwrites this header with a trusted client IP.
TRUSTED_IP_HEADER=
# Future agent integration; server-only, unused in V1.
AGENT_PROVIDER=
AGENT_ENDPOINT=
AGENT_API_KEY=
